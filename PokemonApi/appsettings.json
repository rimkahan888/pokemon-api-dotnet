{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PokeApi": {
    "BaseUrl": "https://pokeapi.co/api/v2/",
    "ClientTimeoutSeconds": 10,
    "RequestTimeoutSeconds": 5,
    "RetryAttempts": 3,
    "RetryBackoffMilliseconds": 200,
    "DetailCacheMinutes": 10,
    "ListCacheMinutes": 5,
    "FallbackSpriteBaseUrl": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon"
  }
}
